@model IEnumerable<ClinicaOdontologicaModelos.Tratamiento>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.costoBase)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.duracioonEstimadaMinutos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DetallesCita)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.costoBase)
            </td>
            <td>
                @Html.DisplayFor(model => item.duracioonEstimadaMinutos)
            </td>
            <td>
                @Html.DisplayFor(model => item.DetallesCita)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdTratamiento">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdTratamiento">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdTratamiento">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
